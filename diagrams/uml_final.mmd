
classDiagram
    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +date due_date
        +mark_complete() None
        +next_occurrence() Task
    }

    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task) None
        +get_task_count() int
    }

    class Owner {
        +str name
        +List~Pet~ pets
        +get_all_tasks() List~Task~
        +add_pet(pet) None
    }

    class Scheduler {
        -Owner owner
        +get_tasks() List~Task~
        +sort_by_time() List~Task~
        +organize_tasks() List~Task~
        +filter_by_status(completed) List~Task~
        +filter_by_pet(pet_name) List~Task~
        +complete_task(task) Task
        +detect_conflicts() List~str~
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : contains
    Scheduler --> Owner : manages
    Scheduler ..> Task : sorts, filters, and completes
